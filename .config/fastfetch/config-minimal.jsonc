{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "arch",
    "type": "small",
    "padding": {
      "right": 2
    },
    "color": {
      "1": "#33b1ff",
      "2": "#42be65"
    }
  },
  "display": {
    "color": {
      "keys": "#33b1ff",
      "title": "#42be65"
    },
    "separator": ": ",
    "percent": {
      "color": {
        "green": "#be95ff",
        "yellow": "#80ceff",
        "red": "#ee5396"
      }
    }
  },
  "modules": [
    "os",
    "packages",
    {
      "type": "command",
      "key": "OS Age",
      "text": "first=$(awk 'match($0,/^\\[([^]]+)/,m){print m[1]; exit}' /var/log/pacman.log); days=$((($(date +%s)-$(date -d \"$first\" +%s))/86400)); printf '%s days' \"$days\""
    },
    "cpu",
    "gpu",
    "memory",
    "disk"
  ]
}
