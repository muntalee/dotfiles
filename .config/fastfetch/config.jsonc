{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "arch",
    "type": "small",
    "padding": {
      "right": 2
    },
    "color": {
      "1": "#cb63f7",
      "2": "#fab363"
    }
  },
  "display": {
    "color": {
      "keys": "#cba6f7",
      "title": "#fab387"
    },
    "separator": ": ",
    "percent": {
      "color": {
        "green": "#94e2d5",
        "yellow": "#bb8af4",
        "red": "#f38ba8"
      }
    }
  },
  "modules": [
    "os",
    "packages",
    {
      "type": "command",
      "key": "OS Age",
      "text": "first=$(awk 'match($0,/^\\[([^]]+)/,m){print m[1]; exit}' /var/log/pacman.log); days=$((($(date +%s)-$(date -d \"$first\" +%s))/86400)); printf '%s days' \"$days\""
    },
    "cpu",
    "gpu",
    "memory",
    "disk"
  ]
}
