{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "matugen"
  },
  "session": {
    "sidebar": "hide"
  },
  "tabs": {
    "indicators": "numbers",
    "mode": "off"
  },
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "allow",
      "sudo *": "ask"
    },
    "zsh": {
      "*": "allow",
      "sudo *": "ask"
    }
  }
}
