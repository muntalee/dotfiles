set $mod Mod4
set $term kitty
set $browser uwsm-app -- xdg-open https://
set $filemanager uwsm-app -- nautilus

# Display settings are generated by nwg-displays. Keep this include after the
# variables so the generated file remains the single source of output options.
include ~/.config/sway/outputs

# Input
font pango:JetBrainsMono NF 10

input * {
    xkb_layout us
    xkb_options caps:ctrl_modifier,caps:shiftlock,grp:alts_toggle
    repeat_rate 40
    repeat_delay 250
    pointer_accel 0.35
    accel_profile flat
}

input type:touchpad {
    natural_scroll enabled
    click_method clickfinger
    scroll_factor 0.4
    dwt disabled
}

default_border normal
default_floating_border normal
gaps inner 0
gaps outer 0
focus_follows_mouse yes
mouse_warping container
floating_modifier $mod normal

# Layout
workspace_layout tabbed
hide_edge_borders --i3 none

# Workspace placement
# Keep the familiar monitor assignment: numbered workspaces on HDMI, D on eDP.
workspace number 1 output HDMI-A-1
workspace number 2 output HDMI-A-1
workspace number 3 output HDMI-A-1
workspace number 4 output HDMI-A-1
workspace number 5 output HDMI-A-1
workspace number 6 output HDMI-A-1
workspace number 7 output HDMI-A-1
workspace number 8 output HDMI-A-1
workspace number 9 output HDMI-A-1
workspace D output eDP-1

# Startup
exec sh -c 'systemctl --user import-environment WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE && dbus-update-activation-environment --systemd --all && systemctl --user start hyprpolkitagent.service'
exec sh -c 'if [ -n "$XDG_RUNTIME_DIR" ]; then rm -f "$XDG_RUNTIME_DIR/sway-gammastep-off"; fi; exec gammastep'
exec waypaper --restore
exec swayidle -w timeout 300 '$HOME/.config/sway/caffeine run swaylock -f --screenshots --effect-blur 7x5' timeout 900 '$HOME/.config/sway/caffeine run systemctl suspend' before-sleep 'swaylock -f --screenshots --effect-blur 7x5'

# Status bar
# Swaybar provides the status line and system tray.
bar {
    status_command ~/.config/sway/i3status
    font pango:JetBrainsMono NF 10
    tray_output eDP-1
}

# Window rules
# Keep applet windows and dialogs out of the tiled layout.
# for_window [app_id="kitty"] floating enable
for_window [window_type="dialog"] floating enable
for_window [window_type="utility"] floating enable
for_window [app_id="nm-connection-editor"] floating enable
for_window [app_id="nmrs"] floating enable
for_window [app_id="blueman-manager"] floating enable
for_window [title="^Waypaper$"] floating enable, move position center

# Application shortcuts
bindsym $mod+Return exec $term
bindsym $mod+Shift+Return exec $browser
bindsym $mod+Shift+f exec ~/.config/sway/open-file-manager
bindsym $mod+space exec fuzzel
bindsym $mod+comma exec ~/.config/sway/settings-menu
bindsym $mod+period exec blueman-manager
bindsym $mod+Escape exec ~/.config/sway/session-menu
bindsym $mod+Shift+Escape exec ~/.config/sway/session-menu
bindsym $mod+Shift+z exec ~/.config/sway/toggle-gammastep
bindsym $mod+Ctrl+l exec swaylock -f -c 000000
bindsym $mod+Shift+q exec swaymsg exit
bindsym $mod+Shift+r reload
bindsym $mod+Shift+b exec $browser
bindsym $mod+Shift+n exec $term -e vi
bindsym $mod+Shift+c exec $term -e copilot --yolo

# Window management shortcuts
bindsym $mod+f fullscreen toggle
bindsym $mod+w kill
bindsym $mod+t floating toggle
bindsym $mod+o sticky toggle
bindsym $mod+backslash layout toggle splith splitv tabbed
bindsym $mod+s scratchpad show
bindsym $mod+Alt+s move container to scratchpad

# Focus and movement shortcuts
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Workspace shortcuts
bindsym $mod+d workspace D
bindsym $mod+Shift+d move container to workspace D
bindsym $mod+Ctrl+Tab workspace back_and_forth
bindsym $mod+Tab workspace next
bindsym $mod+Shift+Tab workspace prev
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9

# Screenshots, clipboard, audio, and brightness
bindsym Print exec grim - | wl-copy
bindsym Ctrl+Alt+Shift+3 exec grim - | wl-copy
bindsym Ctrl+Alt+Shift+4 exec sh -c 'grim -g "$(slurp)" - | wl-copy'
bindsym $mod+c exec sh -c 'wl-paste --no-newline | wl-copy --trim-newline'

bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86MonBrightnessUp exec brightnessctl set 5%+
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-
bindsym --locked XF86AudioPlay exec playerctl play-pause
bindsym --locked XF86AudioNext exec playerctl next
bindsym --locked XF86AudioPrev exec playerctl previous
bindsym --locked XF86AudioStop exec playerctl stop
